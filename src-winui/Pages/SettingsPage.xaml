<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WT8111Neo_Control.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WT8111Neo_Control.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            MaxWidth="920"
            Padding="28,20,28,28"
            HorizontalAlignment="Left"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Cloud Room Management" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Paste the Relay URL from the Cloud Tactical Server room panel." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <ToggleSwitch
                        x:Name="RelayEnabledSwitch"
                        Header="Enable relay upload"
                        OffContent="Disabled"
                        OnContent="Enabled" />

                    <TextBox
                        x:Name="ServerUrlBox"
                        Header="Relay URL"
                        PlaceholderText="ws://192.168.5.182:17712/ws/rooms/test/relay"
                        TextChanged="ConnectionField_TextChanged" />

                    <TextBox
                        x:Name="RoomIdBox"
                        Header="Room ID (parsed)"
                        IsReadOnly="True"
                        PlaceholderText="Parsed from Relay URL" />

                    <PasswordBox
                        x:Name="AccessPasswordBox"
                        Header="Password (optional)"
                        PlaceholderText="Leave empty for a public room" />

                    <TextBox
                        x:Name="PlayerNameBox"
                        Header="Player name (optional)"
                        PlaceholderText="Callsign used in relay observation frames" />

                    <Border
                        Padding="14"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Server" />
                            <TextBlock
                                x:Name="RelayUrlText"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                Grid.Row="1"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Viewer URL" />
                            <TextBlock
                                x:Name="ViewerUrlText"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                Grid.Row="2"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Web GUI" />
                            <TextBlock
                                x:Name="WebGuiUrlText"
                                Grid.Row="2"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Click="SaveSettings_Click"
                            Content="Save settings" />
                        <Button
                            Click="TestServer_Click"
                            Content="Test server" />
                        <Button
                            Click="JoinRoom_Click"
                            Content="Join room" />
                        <Button
                            Click="RefreshRooms_Click"
                            Content="Refresh rooms" />
                        <Button
                            Click="ResetSettings_Click"
                            Content="Reset form" />
                    </StackPanel>

                    <Border
                        Padding="14"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="CloudStatusIcon"
                                FontSize="20"
                                Glyph="&#xE968;" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    x:Name="CloudStatusTitle"
                                    FontWeight="SemiBold"
                                    Text="Cloud status not checked" />
                                <TextBlock
                                    x:Name="CloudStatusMessage"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Paste Relay URL, then test or join the room."
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="CloudStatusDetail"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Padding="14"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="10">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Active Rooms" />
                            <ListView
                                x:Name="ActiveRoomsList"
                                MaxHeight="180" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="SettingsStatusBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="Storage note"
                Message="The client stores the Relay URL-derived server and room, plus the optional room password and player name." />
        </Grid>
    </ScrollViewer>
</Page>
