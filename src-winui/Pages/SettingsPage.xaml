<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WT8111Neo_Control.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WT8111Neo_Control.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            MaxWidth="920"
            Padding="28,20,28,28"
            HorizontalAlignment="Left"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Sync Settings" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Local-only settings for future tactical relay and squad situation aggregation." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <ToggleSwitch
                        x:Name="RelayEnabledSwitch"
                        Header="Enable relay upload"
                        OffContent="Disabled"
                        OnContent="Enabled" />

                    <TextBox
                        x:Name="ServerUrlBox"
                        Header="Server address"
                        PlaceholderText="https://example.com/wt8111" />

                    <TextBox
                        x:Name="PlayerNameBox"
                        Header="Player name"
                        PlaceholderText="Callsign shown to the squad server" />

                    <PasswordBox
                        x:Name="AccessPasswordBox"
                        Header="Access password"
                        PlaceholderText="Stored locally in the portable settings file for now" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Click="SaveSettings_Click"
                            Content="Save settings" />
                        <Button
                            Click="ResetSettings_Click"
                            Content="Reset form" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="SettingsStatusBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="Storage note"
                Message="These controls are the intended home for sensitive local settings. The backing configuration writer will be connected after the relay protocol is finalized." />
        </Grid>
    </ScrollViewer>
</Page>
