<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WT8111Neo_Control.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WT8111Neo_Control.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            MaxWidth="1120"
            Padding="28,20,28,28"
            HorizontalAlignment="Left"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Local Control Dashboard" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Service status, browser entry points, and local-only controls for WT 8111 Neo." />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Web GUI" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Browser clients connect to the Rust service hosted on the game PC." />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="18"
                                Glyph="&#xE774;" />
                            <TextBlock
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Text="http://127.0.0.1:17711" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Click="CheckService_Click"
                                Content="Check service" />
                            <Button
                                Click="OpenWebGui_Click"
                                Content="Open Web GUI" />
                            <Button
                                Click="CopyLocalUrl_Click"
                                Content="Copy URL" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Service" />
                        <InfoBar
                            x:Name="ServiceStatusBar"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational"
                            Title="Expected"
                            Message="Run wt-8111-neo.exe to host the Web GUI and proxy War Thunder 8111 data." />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The WinUI client is the local settings surface. It does not replace the browser map interface used by tablets or other LAN devices." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="22"
                            Glyph="&#xE707;" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Map-first workflow" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Current development priority is the tactical map, markers, ranging, and artillery tools." />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="22"
                            Glyph="&#xE968;" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Room relay" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Paste the server-provided Relay URL; the client derives server and room internally." />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="22"
                            Glyph="&#xE722;" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Capture paused" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Visual radar recognition is retained as a research note, not an active feature." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
