<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WT8111Neo_Control.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WT8111Neo_Control.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            MaxWidth="860"
            Padding="28,20,28,28"
            HorizontalAlignment="Left"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="About WT 8111 Neo" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="A local tactical map companion for War Thunder's 8111 data interface." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Architecture" />
                    <TextBlock Text="Browser Web GUI: tactical map and tools." />
                    <TextBlock Text="Rust service: 8111 proxy and Web GUI hosting." />
                    <TextBlock Text="WinUI 3 client: local settings, relay setup, and future host-only controls." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
